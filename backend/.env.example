# ===== Database =====
# Dev: SQLite (default). Produksi: postgresql+psycopg2://user:pass@host:5432/db
DATABASE_URL=sqlite:///./autograding.db

# ===== Auth =====
# Ganti dengan secret acak panjang (jangan commit nilai asli)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ===== Gemini =====
# Ambil API key dari https://aistudio.google.com/apikey
# Routing per tugas (keputusan Fase 2A + validasi foto asli):
#   MCQ/isian -> lite (200 RPD, akurasi seri, cepat)
#   Esai      -> flash (5 RPM/20 RPD, reasoning lebih kuat)
#   Fallback  -> dipakai otomatis saat flash kena 429 (quota habis)
GEMINI_API_KEY=
GEMINI_MODEL_MCQ=gemini-3.5-flash-lite
GEMINI_MODEL_SHORT=gemini-3.5-flash-lite
GEMINI_MODEL_ESSAY=gemini-3.5-flash
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite

# ===== Runtime =====
# true => jawaban AI disimulasikan (tanpa memakai quota Gemini)
GEMINI_MOCK_MODE=false
# Ambang is_correct untuk isian/esai (0-100)
SIMILARITY_THRESHOLD=70
# Direktori penyimpanan crop jawaban
UPLOAD_DIR=uploads
